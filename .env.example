DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optionnel : deploiement des commandes limite a une seule guilde (dev), sinon global
DISCORD_GUILD_ID=

# NorthHost MySQL — format mysql://user:password@hote:port/nom_bdd (identifiants dans le panel NorthHost)
DATABASE_URL=

# Fuseau horaire du jeu (minuit de la bascule jour/nuit) ; Europe/Paris par defaut, meme si le serveur est en UTC
# FUSEAU_HORAIRE=Europe/Paris
